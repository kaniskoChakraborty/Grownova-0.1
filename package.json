{
  "name": "grownova-os",
  "version": "0.1.0",
  "description": "GrowNova OS - Unified Monorepo (Backend, Web, and Mobile)",
  "private": true,
  "workspaces": [
    "backend",
    "web",
    "app"
  ],
  "scripts": {
    "dev": "npm --prefix web run dev",
    "dev:web": "npm --prefix web run dev",
    "dev:app": "npm --prefix app run start",
    "dev:mobile": "npm --prefix app run start",
    "start:mobile": "npm --prefix app run start",
    "dev:backend": "npm --prefix backend run start:dev",
    "build": "npm --prefix backend run build && npm --prefix web run build",
    "build:backend": "npm --prefix backend run build",
    "build:web": "npm --prefix web run build",
    "start:backend": "npm --prefix backend run start:prod",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:generate": "npm --prefix backend run db:generate",
    "db:seed": "npm --prefix backend run db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v"
  }
}
