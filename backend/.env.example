# ==============================================================================
# GrowNova OS — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# NEVER commit production secrets or real API keys to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Standard local Docker PostgreSQL connection string:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grownova?schema=public"

# Docker Compose Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grownova
POSTGRES_PORT=5432

# Redis Cache & Session Store
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET="dev-access-secret-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Integration
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
