generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ACCOUNTANT
  OPS
  EMPLOYEE
}

model Business {
  leads     Lead[]
  invoices  Invoice[]
  invoiceCounters InvoiceCounter[]
  products        Product[]
  productVariants ProductVariant[]
  locations       Location[]
  stockLevels     StockLevel[]
  stockLedger     StockLedgerEntry[]
  batches         Batch[]
  posOrders       PosOrder[]
  upiPayments     UpiPayment[]
  syncConflicts   PosSyncConflict[]
  accounts        Account[]
  journals        Journal[]
  id        String   @id @default(uuid())
  name      String
  industry  String?
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  gstin     String?
  upiId     String? // VPA customers pay to, e.g. shop@okicici
  country   String   @default("India")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  modules Module[]
}

model User {
  id           String   @id @default(uuid())
  businessId   String
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  leadStageEvents LeadStageEvent[]

  @@index([businessId])
}

model Module {
  id         String   @id @default(uuid())
  businessId String
  key        String
  name       String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId])
}

model AuditLog {
  id           String   @id @default(uuid())
  businessId   String
  actorId      String?
  action       String
  entity       String
  entityId     String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  previousHash String?
  hash         String
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum LeadSource {
  MANUAL
  WHATSAPP
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model Lead {
  id         String     @id @default(uuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String?
  phone      String?
  email      String?
  source     LeadSource @default(MANUAL)
  status     LeadStatus @default(NEW)
  rawMessage String?
  notes      String?
  score      Int?
  enrichment Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  stageEvents LeadStageEvent[]
  reminders   LeadReminder[]
  invoices    Invoice[]

  @@index([businessId, status])
}

/// One row per pipeline stage change. actorId is null when the system moved the lead (auto-qualify).
model LeadStageEvent {
  id         String     @id @default(uuid())
  leadId     String
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus LeadStatus
  toStatus   LeadStatus
  actorId    String?
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([leadId, createdAt])
}

enum ReminderStatus {
  PENDING
  SENT
}

/// Follow-up reminder on a lead. A BullMQ delayed job fires it at dueAt.
model LeadReminder {
  id          String         @id @default(uuid())
  leadId      String
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  note        String
  dueAt       DateTime
  status      ReminderStatus @default(PENDING)
  sentAt      DateTime?
  createdById String?
  createdAt   DateTime       @default(now())

  @@index([leadId, dueAt])
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK
  CARD
}

/// Sales invoice to a lead. amountPaid is the running sum of its payments, updated in the same transaction.
model Invoice {
  id         String         @id @default(uuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  number     String
  total      Decimal        @db.Decimal(12, 2)
  amountPaid Decimal        @default(0) @db.Decimal(12, 2)
  status     InvoiceStatus  @default(UNPAID)
  dueDate    DateTime
  irn        String?        @unique // e-invoice reference from the GST portal (mocked for now)
  ackNo      String?
  ackDate    DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  payments InvoicePayment[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([leadId])
}

model InvoicePayment {
  id           String        @id @default(uuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  recordedById String?
  paidAt       DateTime      @default(now())

  @@index([invoiceId])
}

// Next serial per business, document series and financial year (GST wants a fresh series each April).
model InvoiceCounter {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  series     String   @default("INV") // INV for invoices, POS for counter sales
  fy         String // e.g. "2026-27"
  last       Int      @default(0)

  @@id([businessId, series, fy])
}

/// Something the business sells. Stock is tracked per variant, so every product has at least one.
model Product {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  hsnCode    String?
  unit       String   @default("pcs") // pcs, kg, litre, box...
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  variants ProductVariant[]

  @@index([businessId, name])
}

/// A sellable SKU, e.g. "Basmati Rice 5kg". businessId is copied from the product so SKU and barcode are unique per business.
model ProductVariant {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String
  name              String?
  barcode           String?
  attributes        Json? // e.g. { "size": "L", "colour": "Red" }
  costPrice         Decimal  @default(0) @db.Decimal(12, 2)
  salePrice         Decimal  @default(0) @db.Decimal(12, 2)
  lowStockThreshold Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockLevels StockLevel[]
  stockLedger StockLedgerEntry[]
  batches     Batch[]
  posLines    PosOrderLine[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([productId])
}

/// Where stock sits: a shop, godown or warehouse.
model Location {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stockLevels StockLevel[]
  stockLedger StockLedgerEntry[]
  batchStocks BatchStock[]
  posOrders   PosOrder[]

  @@unique([businessId, name])
}

enum StockMovementType {
  IN // purchase, customer return
  OUT // sale, damage, expiry
  ADJUST // physical count, sets stock to what was counted
  TRANSFER_OUT // leaving a location, paired with a TRANSFER_IN by transferId
  TRANSFER_IN
}

/// Current stock of a variant at a location. Kept in step with the ledger in the same transaction.
model StockLevel {
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quantity   Decimal        @default(0) @db.Decimal(12, 3)
  updatedAt  DateTime       @updatedAt

  @@id([variantId, locationId])
  @@index([businessId, locationId])
}

/// Append-only record of every stock change (a database trigger blocks UPDATE and DELETE).
/// quantity is the signed change; balanceAfter is the stock at that location right after it.
model StockLedgerEntry {
  id           String            @id @default(uuid())
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)
  balanceAfter Decimal           @db.Decimal(12, 3)
  unitCost     Decimal           @db.Decimal(12, 2) // cost per unit at the time, for COGS
  reference    String? // supplier bill or invoice number
  note         String?
  actorId      String?
  transferId   String? // shared by the TRANSFER_OUT and TRANSFER_IN rows of one transfer
  batchId      String?
  batch        Batch?            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  posOrderId   String? // the POS sale (or its cancellation) that moved this stock
  createdAt    DateTime          @default(now())

  @@index([businessId, variantId, locationId, createdAt])
  @@index([transferId])
  @@index([batchId, createdAt])
  @@index([businessId, createdAt])
  @@index([posOrderId])
}

/// A lot of one variant, e.g. a delivery of medicine with its own expiry date. Created by the first IN that names it.
model Batch {
  id         String         @id @default(uuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batchNo    String
  mfgDate    DateTime?      @db.Date
  expiryDate DateTime?      @db.Date
  createdAt  DateTime       @default(now())

  stocks BatchStock[]
  ledger StockLedgerEntry[]

  @@unique([variantId, batchNo])
  @@index([businessId, expiryDate])
}

/// How much of a batch sits at a location. The variant's StockLevel there is this plus any stock without a batch.
model BatchStock {
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt  DateTime @updatedAt

  @@id([batchId, locationId])
  @@index([locationId])
}

enum PosOrderStatus {
  PENDING_PAYMENT // UPI sale waiting for the bank's callback
  PAID
  CANCELLED
}

/// A counter sale. Its stock leaves the location the moment the order is created; cancelling puts it back.
model PosOrder {
  id             String         @id @default(uuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  number         String // POS/26-27/000001
  status         PosOrderStatus
  paymentMethod  PaymentMethod
  total          Decimal        @db.Decimal(12, 2)
  customerName   String?
  customerPhone  String?
  idempotencyKey String? // the client's Idempotency-Key header; a repeat returns this order
  createdById    String?
  paidAt         DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  upiTxnRef      String?        @unique // tr= in the UPI link; the bank echoes it back in its callback
  ewbNo          String?        @unique // e-way bill number (mock GSTN portal)
  ewbDate        DateTime?
  ewbValidUntil  DateTime?
  ewb            Json? // consignee, vehicle, distance and HSN lines as sent to the portal
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines       PosOrderLine[]
  upiPayments UpiPayment[]

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
}

model PosOrderLine {
  id        String         @id @default(uuid())
  orderId   String
  order     PosOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Decimal        @db.Decimal(12, 3)
  unitPrice Decimal        @db.Decimal(12, 2)
  lineTotal Decimal        @db.Decimal(12, 2)

  @@index([orderId])
}

enum UpiCallbackResult {
  MATCHED // order marked PAID
  AMOUNT_MISMATCH // money arrived but not the order total; order left as it was
  ORDER_NOT_PENDING // order already paid or cancelled; money needs a refund or a look
  UNKNOWN_REF // no order has this txnRef
  FAILED // the bank reported a failed payment
}

/// Every callback the UPI provider sends, kept even when it matches nothing, for reconciliation.
model UpiPayment {
  id         String            @id @default(uuid())
  businessId String?
  business   Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId    String?
  order      PosOrder?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  txnRef     String
  utr        String            @unique // bank reference; a repeated callback with the same UTR is ignored
  amount     Decimal           @db.Decimal(12, 2)
  status     String // SUCCESS or FAILED, as the bank reported it
  payerVpa   String?
  result     UpiCallbackResult
  receivedAt DateTime          @default(now())

  @@index([businessId, receivedAt])
  @@index([orderId])
}

enum SyncConflictType {
  PRICE_CHANGED // sold offline at an old price; the offline price was kept
  STOCK_SHORT // sold more offline than the system had; booked in full, stock deducted only down to 0
  REJECTED // could not be booked at all (archived item or shop, bad data); the original sale is in detail
}

enum SyncConflictStatus {
  AUTO_RESOLVED // a rule handled it; kept as a log
  OPEN // needs a person
  RESOLVED
}

/// What happened to offline sales that didn't sync cleanly.
model PosSyncConflict {
  id           String             @id @default(uuid())
  businessId   String
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deviceId     String
  clientId     String // the till's own id for the sale
  orderId      String? // the booked order; null when REJECTED
  type         SyncConflictType
  status       SyncConflictStatus
  detail       Json
  note         String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())

  @@index([businessId, status, createdAt])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// A ledger account in the business's chart of accounts. Seeded accounts (isSystem) are what automatic postings use.
model Account {
  id         String        @id @default(uuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code       String // e.g. "1000"
  name       String
  type       AccountType
  isSystem   Boolean       @default(false) // seeded; can be renamed but not archived
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  lines      JournalLine[]

  @@unique([businessId, code])
  @@unique([businessId, name])
}

enum JournalSource {
  MANUAL
  REVERSAL
  POS_SALE // sourceId = PosOrder.id
  INVOICE // sourceId = Invoice.id
  PAYMENT // sourceId = InvoicePayment.id or UpiPayment.id
}

/// A posted double-entry journal. Append-only: mistakes are fixed by posting its reversal, never by editing.
model Journal {
  id           String        @id @default(uuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number       String // JV/26-27/000001
  date         DateTime      @db.Date // accounting date (India time)
  narration    String
  total        Decimal       @db.Decimal(14, 2) // sum of debits (= sum of credits)
  source       JournalSource @default(MANUAL)
  sourceId     String? // the sale, invoice or payment an automatic journal was posted for
  reversalOfId String?       @unique // the journal this one cancels out
  reversalOf   Journal?      @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: NoAction)
  reversedBy   Journal?      @relation("Reversal")
  createdById  String?
  createdAt    DateTime      @default(now())
  lines        JournalLine[]

  @@unique([businessId, number])
  @@unique([businessId, source, sourceId]) // one journal per business event
  @@index([businessId, date])
}

model JournalLine {
  id        String   @id @default(uuid())
  journalId String
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debit     Decimal  @default(0) @db.Decimal(14, 2)
  credit    Decimal  @default(0) @db.Decimal(14, 2)
  note      String?

  @@index([journalId])
  @@index([accountId])
}
