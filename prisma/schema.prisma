generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ACCOUNTANT
  OPS
  EMPLOYEE
}

model Business {
  leads     Lead[]
  invoices  Invoice[]
  invoiceCounters InvoiceCounter[]
  id        String   @id @default(uuid())
  name      String
  industry  String?
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  gstin     String?
  country   String   @default("India")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  modules Module[]
}

model User {
  id           String   @id @default(uuid())
  businessId   String
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  leadStageEvents LeadStageEvent[]

  @@index([businessId])
}

model Module {
  id         String   @id @default(uuid())
  businessId String
  key        String
  name       String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId])
}

model AuditLog {
  id           String   @id @default(uuid())
  businessId   String
  actorId      String?
  action       String
  entity       String
  entityId     String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  previousHash String?
  hash         String
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum LeadSource {
  MANUAL
  WHATSAPP
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model Lead {
  id         String     @id @default(uuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String?
  phone      String?
  email      String?
  source     LeadSource @default(MANUAL)
  status     LeadStatus @default(NEW)
  rawMessage String?
  notes      String?
  score      Int?
  enrichment Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  stageEvents LeadStageEvent[]
  reminders   LeadReminder[]
  invoices    Invoice[]

  @@index([businessId, status])
}

/// One row per pipeline stage change. actorId is null when the system moved the lead (auto-qualify).
model LeadStageEvent {
  id         String     @id @default(uuid())
  leadId     String
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus LeadStatus
  toStatus   LeadStatus
  actorId    String?
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([leadId, createdAt])
}

enum ReminderStatus {
  PENDING
  SENT
}

/// Follow-up reminder on a lead. A BullMQ delayed job fires it at dueAt.
model LeadReminder {
  id          String         @id @default(uuid())
  leadId      String
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  note        String
  dueAt       DateTime
  status      ReminderStatus @default(PENDING)
  sentAt      DateTime?
  createdById String?
  createdAt   DateTime       @default(now())

  @@index([leadId, dueAt])
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK
  CARD
}

/// Sales invoice to a lead. amountPaid is the running sum of its payments, updated in the same transaction.
model Invoice {
  id         String         @id @default(uuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  number     String
  total      Decimal        @db.Decimal(12, 2)
  amountPaid Decimal        @default(0) @db.Decimal(12, 2)
  status     InvoiceStatus  @default(UNPAID)
  dueDate    DateTime
  irn        String?        @unique // e-invoice reference from the GST portal (mocked for now)
  ackNo      String?
  ackDate    DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  payments InvoicePayment[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([leadId])
}

model InvoicePayment {
  id           String        @id @default(uuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  recordedById String?
  paidAt       DateTime      @default(now())

  @@index([invoiceId])
}

// Next invoice serial per business per financial year (GST wants a fresh series each April).
model InvoiceCounter {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fy         String // e.g. "2026-27"
  last       Int      @default(0)

  @@id([businessId, fy])
}
